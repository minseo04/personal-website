---
import Base from '../layouts/Base.astro';
import { PROJECTS } from '../data/projects.ts';
---

<Base title="Projects" description="Things I have built, what I owned, and what they taught me.">
  <div class="wrap">
    <h1>Projects</h1>
    <p class="lede">What I built, what I was responsible for, and what it taught me.</p>

    <ul class="entry-list">
      {
        PROJECTS.map((p) => (
          <li>
            <h3>
              {p.href ? <a href={p.href}>{p.name}</a> : p.name}
              {p.repo && (
                <>
                  {' '}<a class="date" href={p.repo}>source</a>
                </>
              )}
            </h3>
            <p><strong>{p.blurb}</strong></p>
            <p>{p.detail}</p>
            {p.owned && (
              <p><span class="date">What I owned</span><br />{p.owned}</p>
            )}
            {p.learned && (
              <p><span class="date">What it taught me</span><br />{p.learned}</p>
            )}
            <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
