# All optional -- the app works with zero configuration.

# LLM backend: "cli" uses your local `claude` CLI (no API key, uses your subscription).
# "api" uses the Anthropic API and requires ANTHROPIC_API_KEY.
# Default: "api" if ANTHROPIC_API_KEY is set, otherwise "cli".
# DN_LLM=cli
# ANTHROPIC_API_KEY=sk-ant-...

# Interest half-life in days: how fast a topic fades when you stop asking about it.
# DN_HALF_LIFE_DAYS=21

# How many topics drive each digest, and how many items the digest contains.
# DN_ACTIVE_TOPICS=8
# DN_ITEMS=7

# Where your Claude Code transcripts live.
# DN_TRANSCRIPTS=C:\Users\you\.claude\projects

# Optional: raises the GitHub API rate limit from 60/hr to 5000/hr.
# GITHUB_TOKEN=ghp_...

# PORT=4317

# Interface to bind. Defaults to 127.0.0.1 (loopback only).
# The dashboard has NO authentication and serves your raw prompts -- only change
# this behind a private network (Tailscale) or an authenticating reverse proxy.
# DN_HOST=127.0.0.1
